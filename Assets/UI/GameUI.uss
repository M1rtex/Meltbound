#root {
    width: 100%;
    height: 100%;
}

.heal-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    background-image: url("project://database/Assets/Sprites/Vignette/%D0%B7%D0%B5%D0%BB%D1%91%D0%BD%D1%8B%D0%B9%20%D0%B2%D0%B8%D0%BD%D1%8C%D0%B5%D1%82%D0%BA%D0%B0.png?fileID=2800000&guid=1d952a779943d6848afe19c182206706&type=3#зелёный виньетка");
    transition-property: opacity;
    transition-duration: 0.2s;
    -unity-background-scale-mode: stretch-to-fill;
    flex-grow: 1;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.health-container {
    position: absolute;
    left: 20px;
    top: 20px;
    width: 320px;
    height: 50px;
    scale: 1 1;
}

.health-bar {
    width: 100%;
    height: 100%;
    min-height: 40px;
    border-radius: 25px;
    border-width: 5px;
    border-color: rgba(100, 180, 255, 0.8);
    overflow: hidden;
}

#root > #health-container > #health-bar > #unity-progress-bar > .unity-progress-bar__background {
    background-color: rgba(30, 40, 50, 0.95);
    border-radius: 20px;
    border-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

#root > #health-container > #health-bar > #unity-progress-bar > .unity-progress-bar__background > .unity-progress-bar__progress {
    background-color: rgb(50, 150, 255);
    border-radius: 15px;
    margin: 0;
    height: 100%;
}

#root > #health-container > #health-bar > #unity-progress-bar {
    min-height: 100%;
    margin: 0;
    padding: 0;
}

.buttons-container {
    position: absolute;
    right: 20px;
    top: 20px;
    flex-direction: column;
    width: 140px;
}

.game-button {
    height: 55px;
    margin-bottom: 12px;
    background-color: rgba(70, 130, 180, 0.9);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgba(120, 180, 240, 0.9);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.game-button:hover {
    background-color: rgba(100, 160, 220, 0.95);
    border-color: rgb(150, 200, 255);
    scale: 1.05;
    translate: 0 -2px;
}

.game-button:active {
    background-color: rgb(40, 80, 120);
    border-color: rgb(80, 120, 160);
    scale: 0.95;
    translate: 0 1px;
}

.menu-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 30, 50, 0.92);
    align-items: center;
    justify-content: center;
}

.menu-panel {
    width: 450px;
    min-height: 350px;
    background-color: rgba(60, 100, 140, 0.85);
    border-radius: 20px;
    border-width: 4px;
    border-color: rgba(120, 180, 240, 0.95);
    padding: 50px;
    align-items: center;
    justify-content: center;
}

.menu-title {
    font-size: 56px;
    color: rgb(200, 230, 255);
    -unity-font-style: bold;
    margin-bottom: 50px;
    -unity-text-align: middle-center;
}

.game-over-title {
    color: rgb(255, 100, 100);
    text-shadow: 0 0 15px rgba(255, 80, 80, 0.7);
}

.menu-button {
    width: 280px;
    height: 70px;
    margin-top: 18px;
    background-color: rgba(70, 130, 180, 0.9);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgba(120, 180, 240, 0.95);
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.menu-button:hover {
    background-color: rgba(100, 160, 220, 0.95);
    border-color: rgb(150, 200, 255);
    scale: 1.08;
    translate: 0 -3px;
}

.menu-button:active {
    background-color: rgb(40, 80, 120);
    border-color: rgb(80, 120, 160);
    scale: 0.96;
    translate: 0 1px;
}
