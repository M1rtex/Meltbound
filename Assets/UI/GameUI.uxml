<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI.uss?fileID=7433441132597879392&amp;guid=f13854a105ea2d54dba3a5d8988dc7de&amp;type=3#GameUI"/>
    <ui:VisualElement name="root" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="heal-vignette" class="heal-vignette" style="flex-grow: 1;"/>
        <ui:Label name="level-banner" class="level-banner" text="Уровень 1"/>
        <ui:VisualElement name="buttons-container" class="buttons-container">
            <ui:Button name="pause-button" text="Pause" class="game-button"/>
            <ui:Button name="restart-button" text="Restart" class="game-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="health-container" class="health-container">
            <ui:ProgressBar name="health-bar" title="" value="100" high-value="100" class="health-bar"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
