:root {
}

.menu {
    background-color: rgba(66, 199, 255, 0.29);
    justify-content: center;
    align-items: center;
    width: 92%;
    border-top-left-radius: 5%;
    border-top-right-radius: 5%;
    border-bottom-right-radius: 0%;
    border-bottom-left-radius: 0%;
    margin-top: 15%;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0%;
}

.panel {
    align-items: center;
}

.button {
    width: 90%;
    height: 20%;
    border-top-left-radius: 5%;
    border-top-right-radius: 5%;
    border-bottom-right-radius: 5%;
    border-bottom-left-radius: 5%;
    border-right-width: 0;
    background-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Sprites/Nature%20Backgrounds%20Pixel%20Art%202/PNG/Background_3/Layer_5.png?fileID=2800000&guid=b98c17f9f3e382d4a97abcfde7423e2d&type=3#Layer_5");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    align-self: center;
    align-content: auto;
    aspect-ratio: auto;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 2%;
    margin-left: 0;
}

.unity-button {
    border-top-left-radius: 5%;
    border-top-right-radius: 5%;
    border-bottom-right-radius: 5%;
    border-bottom-left-radius: 5%;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(59, 151, 171);
    border-right-color: rgb(59, 151, 171);
    border-top-color: rgb(59, 151, 171);
    border-bottom-color: rgb(59, 151, 171);
}

.unity-text-element {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    -unity-font-style: normal;
    font-size: 48px;
    color: rgb(30, 95, 108);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(63, 165, 188);
    -unity-text-align: middle-center;
}

.unity-image {
    cursor: initial;
}

.buttons_container {
    width: 90%;
}

.button:hover {
    -unity-background-image-tint-color: rgb(229, 229, 229);
    scale: 1.02 1;
}

.level_button {
}

.level_button:hover {
    scale: 1.05 1.05 1.05;
}
