.dialogue-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
}

.dialogue-box {
    position: absolute;
    top: 10%;
    left: 50%;
    translate: -50% 0;
    padding-top: 34px;
    padding-right: 24px;
    padding-bottom: 28px;
    padding-left: 24px;
    min-width: 350px;
    max-width: 500px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/UI/Dialog/Dialog_window.png?fileID=384774601818996989&guid=18c7b3f46b98bf74a924a219e29f8b61&type=3#Dialog_window_3");
    -unity-background-scale-mode: stretch-to-fill;
    flex-shrink: 0;
    flex-grow: 0;
}

.dialogue-text {
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(13, 27, 42);
    font-size: 22px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.8);
    margin: 0;
    padding: 0;
}
